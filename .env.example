# ============================================================================
#  TechMart - environment variables
#  Copy this file to `.env` for local development, and add the same keys in
#  Vercel -> Project -> Settings -> Environment Variables for production.
#  Never commit the real `.env`.
# ============================================================================

# ---- Supabase (browser safe: the anon key is designed to be public) --------
# Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Email / SMTP (SERVER ONLY - read by api/send-order-email.js) ----------
# Order receipts are sent with Nodemailer over SMTP.
#
# Configured provider: GOOGLE (Gmail or Google Workspace)
#   SMTP_USER = your FULL Google address, e.g. you@gmail.com
#   SMTP_PASS = a 16-character APP PASSWORD, not your Google password.
#               Turn on 2-Step Verification first, then create one at
#               Google Account -> Security -> App passwords.
#   Port 465 = SSL (secure is auto-detected) - port 587 also works (STARTTLS).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Leave blank to auto-detect: true for port 465, false (STARTTLS) for 587/25.
SMTP_SECURE=
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-character-app-password
# Any other provider still works: point SMTP_HOST/PORT/USER/PASS at it, or use
# SMTP_SERVICE (e.g. Gmail) / SMTP_URL (smtps://user:pass@smtp.example.com:465).
SMTP_SERVICE=
SMTP_URL=
# Gmail only lets you send as the signed-in account, or an alias you added under
# Gmail -> Settings -> Accounts and Import -> "Send mail as".
MAIL_FROM_EMAIL=you@gmail.com
MAIL_FROM_NAME=TechMart Orders
MAIL_REPLY_TO=you@gmail.com

# ---- Application -----------------------------------------------------------
# Public site origin used for the Google OAuth redirect and email links.
# Local:      http://localhost:5173
# Production: https://your-app.vercel.app
APP_URL=http://localhost:5173

# ---- Storefront display (display only - Postgres is authoritative) --------
VITE_STORE_NAME=TechMart
VITE_CURRENCY=NGN
VITE_DELIVERY_FEE=2500
VITE_FREE_DELIVERY_THRESHOLD=150000
