# ============================================================================
#  TechMart - environment variables
#  Copy this file to `.env` for local development, and add the same keys in
#  Vercel -> Project -> Settings -> Environment Variables for production.
#  Never commit the real `.env`.
# ============================================================================

# ---- Supabase (browser safe: the anon key is designed to be public) --------
# Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Mailgun (SERVER ONLY - read by api/send-order-email.js) ---------------
# Mailgun Dashboard -> Sending -> Domains  and  Settings -> API keys
MAILGUN_API_KEY=your-mailgun-private-api-key
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM_EMAIL=orders@mg.techmart.com
MAILGUN_FROM_NAME=TechMart Orders
MAILGUN_REPLY_TO=support@mg.techmart.com
# Use https://api.eu.mailgun.net if your domain is hosted in the EU region.
MAILGUN_API_BASE=https://api.mailgun.net

# ---- Application -----------------------------------------------------------
# Public site origin used for the Google OAuth redirect and email links.
# Local:      http://localhost:5173
# Production: https://your-app.vercel.app
APP_URL=http://localhost:5173

# ---- Storefront display (display only - Postgres is authoritative) --------
VITE_STORE_NAME=TechMart
VITE_CURRENCY=NGN
VITE_DELIVERY_FEE=2500
VITE_FREE_DELIVERY_THRESHOLD=150000
